# Reference list of everything configurable in the Docker Compose dev stack.
# Every value already has a working default (see docker/docker-compose.yml),
# so this file is optional. To override something, copy it to docker/.env
# (Compose auto-loads a .env file next to the compose file) and edit it.

# --- Postgres ---
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp

# --- Django ---
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
